<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name "compose.manager">
<!ENTITY author "mstrhakr">
<!ENTITY version     "2026.11.03.1021">
<!ENTITY launch "Settings/&name;.settings">
<!ENTITY packageVER "&version;">
<!ENTITY packageMD5  "56bdb46ae77fcd83e6781dbe000bf910">
<!ENTITY pkgBUILD    "1021">
<!ENTITY packageName "&name;-&packageVER;-noarch-&pkgBUILD;">
<!ENTITY packagefile "&packageName;.txz">
<!ENTITY github "mstrhakr/compose_plugin">
<!ENTITY pluginURL "https://raw.githubusercontent.com/&github;/dev/&name;.plg">
<!ENTITY packageURL "https://github.com/&github;/releases/download/v&version;/&packagefile;">
<!ENTITY pluginsPATH "/boot/config/plugins">
<!ENTITY pluginLOC "&pluginsPATH;/&name;">
<!ENTITY emhttpPATH "/usr/local/emhttp/plugins">
<!ENTITY emhttpLOC "&emhttpPATH;/&name;">
<!ENTITY pluginsInstalledPATH "/var/log/packages">
<!ENTITY aceVER    "1.43.5">
<!ENTITY aceURL    "https://github.com/ajaxorg/ace-builds/archive/refs/tags/v&aceVER;.zip">
<!ENTITY aceZIP    "ace-v&aceVER;.zip">
<!ENTITY aceSHA256 "40169719746a5f83dcfb6e73a838221d34b91b75a939569217d62fb7d8175562">
]>

<PLUGIN  name="&name;"
         author="&author;"
         version="&version;"
         launch="&launch;"
         pluginURL="&pluginURL;"
         icon="cubes"
         min="6.12.0"
         support="https://forums.unraid.net/topic/197334-plugin-compose-manager-plus/"
         project="https://github.com/mstrhakr/compose_plugin"
         readme="https://github.com/mstrhakr/compose_plugin#readme"
>

<CHANGES>
###2026.11.04.1553
- Features (git): turn a git stack's recreate-on-folder-change on or off in the web UI
- Features (git): turn a git stack's recreate-on-folder-change on or off from the command line
- Features (deploy): allow explicitly skipping pre-build tests
- Features (updates): present compact image readiness details
- Features (updates): distinguish downloaded images from remote updates
- Features (updates): configure manual stopped-service inclusion
- Features (updates): check build-only services against their Dockerfile base image
- Bug Fixes (git): ignore setting save callbacks after editor switches
- Bug Fixes (updates): keep one-off jobs out of actionable update evidence
- Bug Fixes (updates): preserve evidence when runtime enumeration fails
- Bug Fixes (updates): accept and delimit all valid Compose services
- Bug Fixes (updates): resolve relative project directories once
- Bug Fixes (updates): preserve target platforms in manifest and base checks
- Bug Fixes (updates): resolve base contexts and consume all heredoc bodies
- Bug Fixes (updates): preserve application identity and registry failure evidence
- Bug Fixes (updates): preserve explicit automatic project directories
- Bug Fixes (updates): preserve inspected build image references across reloads
- Bug Fixes (ui): seal sticky update header and reuse themed row stripes
- Bug Fixes (ui): keep update action footer outside scrolling content
- Bug Fixes (updates): reject old image evidence during runtime refresh races
- Bug Fixes (ui): polish update dialog layout and isolate service scrolling
- Bug Fixes (updates): clear cached pending evidence on authoritative unknown results
- Bug Fixes (ui): compact update details into a responsive service table
- Bug Fixes (updates): synchronize expanded checking state and fresh detail evidence
- Bug Fixes (updates): discard legacy metadata evidence on cache reads
- Bug Fixes (updates): resolve keyed image targets without dependency ambiguity
- Bug Fixes (updates): persist canonical per-container update evidence
- Bug Fixes (updates): surface build configuration resolution failures
- Bug Fixes (updates): compare configured targets and batch runtime inspection
- Bug Fixes (updates): keep fresh evidence ahead of unknown cached results
- Bug Fixes (updates): preserve unknown readiness across refresh surfaces
- Bug Fixes (updates): normalize managed services across check entry points
- Bug Fixes (updates): target eligible deployed services under lock
- Bug Fixes (lint): resolve shared update engine relative to wrapper for ShellCheck
- Bug Fixes (updates): only follow registry redirects to http(s)
- Bug Fixes (updates): check build services that sit behind profiles
- Bug Fixes (compose): keep updating stacks whose base image is local-only
- Bug Fixes (updates): stop shell redirects from hiding the final Dockerfile stage
- Performance (updates): reuse remote evidence and index frontend merges
- Refactoring (updates): remove unused compatibility paths and profile preparation
- Refactoring (updates): own saved status lifecycle in stack service
- Refactoring (updates): centralize update operation preparation
- Refactoring (updates): unify read-only stack checks
- Refactoring (updates): route every update caller through the shared pipeline
- Refactoring (updates): centralize update execution with explicit automatic policy
- Documentation (agents): make maintainability and clear ownership explicit requirements
- Documentation (agents): require canonical validation and incremental commits
- Documentation (updates): describe the shared pipeline and automatic update policies
- Tests (updates): preserve build-only Rebuild evidence through repeated reloads
- Tests (updates): cover expanded checking feedback during Check All
- [PR #187](https://github.com/mstrhakr/compose_plugin/pull/187)
- [beta release diff](https://github.com/mstrhakr/compose_plugin/compare/v2026.10.27...v2026.11.04.1553)
</CHANGES>

<!-- The 'pre-install' script. -->
<FILE Run="/bin/bash">
<INLINE>
if [ ! -f &emhttpLOC;/include/ProjectIdentity.php ] &amp;&amp; php -r '
libxml_use_internal_errors(true);
foreach (array_slice($argv, 1, 2) as $manifest) {
    if (!is_file($manifest)) continue;
    $plugin = simplexml_load_file($manifest, SimpleXMLElement::class, LIBXML_NONET);
    if ($plugin === false) exit(1);
    exit((string) $plugin["name"] === "compose.manager" &amp;&amp; (string) $plugin["author"] === "dcflachs" ? 0 : 1);
}
exit(is_file($argv[3]) ? 0 : 1);
' /boot/config/plugins/compose.manager.plg /boot/config/plugins-removed/compose.manager.plg &emhttpLOC;/php/util.php; then
    mkdir -p &pluginLOC; || exit 1
    origin_tmp=$(mktemp &pluginLOC;/.legacy-origin.XXXXXX) || exit 1
    if ! printf '%s\n' 'dcflachs' &gt; "$origin_tmp" || ! mv -f "$origin_tmp" &pluginLOC;/legacy-origin; then
        rm -f "$origin_tmp"
        exit 1
    fi
fi

# Remove all but current package file and ace zip from plugin root
rm -f $(ls &pluginLOC;/&name;*.txz 2>/dev/null|grep -v '&packageVER;')
rm -f $(ls &pluginLOC;/ace-v*.zip 2>/dev/null|grep -v '&aceZIP;')

# Clean up legacy package entries (compose.manager-package-*) left by older builds
# that used non-standard Slackware naming and weren't removed by upgradepkg
for pkg in &pluginsInstalledPATH;/&name;-package-*; do
    [ -e "$pkg" ] &amp;&amp; removepkg "$(basename "$pkg")" 2>/dev/null || true
done

#Create projects folder if it doesnt exist
mkdir -p &pluginLOC;/projects
</INLINE>
</FILE>

<!-- The 'install' script. -->
<FILE Name="&pluginLOC;/&packagefile;" Run="upgradepkg --install-new">
<URL>&packageURL;</URL>
<MD5>&packageMD5;</MD5>
</FILE>

<FILE Run="/bin/bash">
<INLINE>
echo ""
echo "----------------------------------------------------"
echo ""
echo "  Ace editor v&aceVER; will only be downloaded and"
echo "       installed for pre-7.0 Unraid versions."
echo ""
echo "  If on 7.0 or later, Ace editor files are included"
echo "      by default and skips will be shown below."
echo ""
echo "----------------------------------------------------"
echo ""
</INLINE>
</FILE>

<!-- Ace editor fallback for pre-7.0: download zip to flash cache -->
<FILE Name="&pluginLOC;/cache-&aceZIP;" Max="6.99.99">
<URL>&aceURL;</URL>
<SHA256>&aceSHA256;</SHA256>
</FILE>

<!-- Ace editor fallback for pre-7.0: copy cached zip to /tmp for extraction -->
<FILE Name="/tmp/temp-&aceZIP;" Max="6.99.99">
<LOCAL>&pluginLOC;/cache-&aceZIP;</LOCAL>
<SHA256>&aceSHA256;</SHA256>
</FILE>

<!-- Ace editor fallback for pre-7.0: extract needed JS files into plugin dir -->
<FILE Name="/tmp/ace-editor-install.sh" Run="/bin/bash" Max="6.99.99">
<INLINE>
&emhttpLOC;/scripts/install-ace.sh /tmp/temp-&aceZIP; &emhttpLOC; &aceVER;
rm -f /tmp/ace-editor-install.sh
</INLINE>
</FILE>

<FILE Run="/bin/bash">
<INLINE>
echo ""
echo "----------------------------------------------------"
echo ""
echo "      Compose Manager Plus has been installed."
echo "               Version: &version;"
echo ""
echo "----------------------------------------------------"
echo ""
</INLINE>
</FILE>

<!-- Uninstall script; plus cleanup old/unused packages -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
# Remove all Slackware package entries for this plugin.
# Handles both new naming (compose.manager-VERSION-noarch-1) and
# legacy naming (compose.manager-package-VERSION) left by older builds.
for pkg in &pluginsInstalledPATH;/&name;-*; do
    [ -e "$pkg" ] &amp;&amp; removepkg "$(basename "$pkg")" 2>/dev/null || true
done

# Remove old package files from flash
rm -f $(ls &pluginLOC;/&name;*.txz 2>/dev/null|grep -v '&packageVER;')
</INLINE>
</FILE>

</PLUGIN>