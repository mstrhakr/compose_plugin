#!/bin/bash
# Compose Manager - Array Started Event Handler
# Starts all compose stacks with autostart enabled sequentially
# Features: priority ordering, logging, timeout protection, Docker wait option

source /usr/local/emhttp/plugins/compose.manager/default.cfg
source /boot/config/plugins/compose.manager/compose.manager.cfg
source /usr/local/emhttp/plugins/compose.manager/scripts/common.sh

COMPOSE_ROOT=$PROJECTS_FOLDER
COMPOSE_WRAPPER=/usr/local/emhttp/plugins/compose.manager/scripts/compose.sh
LOG_FILE="/var/log/compose.manager.log"

# Configuration with defaults
STARTUP_TIMEOUT=${AUTOSTART_TIMEOUT:-300}
WAIT_FOR_DOCKER=${AUTOSTART_WAIT_FOR_DOCKER:-false}
DOCKER_WAIT_TIMEOUT=${AUTOSTART_DOCKER_WAIT_TIMEOUT:-120}

# Ensure Docker daemon is reachable before running compose commands.
wait_for_docker_daemon() {
    local waited=0
    local check_interval=3

    while [ $waited -lt $DOCKER_WAIT_TIMEOUT ]; do
        if docker info >/dev/null 2>&1; then
            log "Docker daemon is ready after ${waited}s"
            return 0
        fi

        if [ $waited -eq 0 ]; then
            log "Waiting for Docker daemon to become ready..."
        fi

        sleep $check_interval
        waited=$((waited + check_interval))
    done

    log "ERROR: Docker daemon was not ready after ${DOCKER_WAIT_TIMEOUT}s"
    return 1
}

# Logging helper — writes to log file and delegates to shared composeLogger for syslog
log() {
    local msg="[$(date '+%Y-%m-%d %H:%M:%S')] $1"
    echo "$msg" >> "$LOG_FILE"
    composeLogger "$1" info autostart
}

# Load the saved UI stack order for the current compose root.
# Prints "project<TAB>position" lines when a saved order exists.
load_saved_stack_order() {
    local compose_root="$1"
    local php_cmd="${COMPOSE_MANAGER_PHP:-php}"

    "$php_cmd" -r '
$composeRoot = $argv[1] ?? "";
$orderFile = "/boot/config/plugins/compose.manager/stack-order.json";
if ($composeRoot === "" || !is_file($orderFile)) {
    exit(0);
}

$normalized = realpath($composeRoot);
if ($normalized === false || $normalized === null) {
    $normalized = rtrim($composeRoot, "/");
}

$json = @file_get_contents($orderFile);
if ($json === false || $json === "") {
    exit(0);
}

$map = json_decode($json, true);
if (!is_array($map)) {
    exit(0);
}

$order = $map[$normalized] ?? [];
if (!is_array($order)) {
    exit(0);
}

foreach (array_values($order) as $index => $project) {
    if (is_string($project) && $project !== "") {
        echo $project, "\t", $index, "\n";
    }
}
' "$compose_root"
}


# Wait for Docker autostart containers to finish starting
wait_for_docker_autostart() {
    log "Waiting for Docker autostart containers to stabilize..."
    
    local waited=0
    local check_interval=5
    local stable_count=0
    local required_stable=2  # Require 2 consecutive stable checks
    local last_starting=0
    
    while [ $waited -lt $DOCKER_WAIT_TIMEOUT ]; do
        # Count containers that are currently starting (not running/healthy yet)
        # Look for containers with "starting" in health status or recently created
        local starting_count=$(docker ps --filter "status=created" --format "{{.ID}}" 2>/dev/null | wc -l)
        
        # Also check for containers with health=starting
        local health_starting=$(docker ps --filter "health=starting" --format "{{.ID}}" 2>/dev/null | wc -l)
        
        local total_starting=$((starting_count + health_starting))
        
        if [ $total_starting -eq 0 ]; then
            stable_count=$((stable_count + 1))
            if [ $stable_count -ge $required_stable ]; then
                log "Docker containers stabilized after ${waited}s"
                return 0
            fi
        else
            stable_count=0
            if [ $total_starting -ne $last_starting ]; then
                log "Waiting for Docker: $total_starting containers still starting..."
                last_starting=$total_starting
            fi
        fi
        
        sleep $check_interval
        waited=$((waited + check_interval))
    done
    
    log "WARNING: Docker wait timeout after ${DOCKER_WAIT_TIMEOUT}s, proceeding anyway"
    return 1
}

resolve_stack_wait_settings() {
    local dir="$1"
    local enabled="${WAIT_FOR_HEALTHY_DEFAULT:-false}"
    local timeout="${WAIT_FOR_HEALTHY_TIMEOUT_DEFAULT:-300}"

    if [ -f "$dir/wait_for_healthy" ]; then
        local raw
        raw=$(tr -d '\r' < "$dir/wait_for_healthy" 2>/dev/null)
        if [ -n "$raw" ]; then
            enabled="$raw"
        fi
    fi

    if [ -f "$dir/wait_timeout" ]; then
        local raw
        raw=$(tr -d '\r' < "$dir/wait_timeout" 2>/dev/null)
        if [ -n "$raw" ]; then
            timeout="$raw"
        fi
    fi

    case "$enabled" in
        true|1|yes|on) enabled="true" ;;
        false|0|no|off|"") enabled="false" ;;
    esac

    timeout="${timeout//[^0-9]/}"
    if [ -z "$timeout" ]; then
        timeout="${WAIT_FOR_HEALTHY_TIMEOUT_DEFAULT:-300}"
    fi

    printf '%s\t%s\n' "$enabled" "$timeout"
}

# Start a single stack with timeout and logging
start_stack() {
    local dir="$1"
    local stack_name="$2"
    local start_time=$(date +%s)
    
    log "Starting stack: $stack_name"
    
    local project
    project=$(basename "$dir")

    # Build command as an array from centralized PHP compose args provider.
    local -a cmd_args=("$COMPOSE_WRAPPER" -c up)
    if ! load_compose_action_spec "$COMPOSE_ROOT" "$project" up "$dir"; then
        local reason="${COMPOSE_SPEC_ERROR_MESSAGE:-compose args provider failed}"
        log "ERROR: Failed to resolve compose args for stack '$stack_name': $reason; skipping startup"
        return 1
    fi

    cmd_args+=(-p "$COMPOSE_SPEC_PROJECT_NAME")
    if [ "$COMPOSE_SPEC_USE_DEFAULT_FILE_DISCOVERY" = "true" ] && [ -n "$COMPOSE_SPEC_PROJECT_DIR" ]; then
        cmd_args+=(-w "$COMPOSE_SPEC_PROJECT_DIR")
    else
        for compose_file in "${COMPOSE_SPEC_COMPOSE_FILES[@]}"; do
            cmd_args+=(-f "$compose_file")
        done
    fi
    if [ -n "$COMPOSE_SPEC_ENV_FILE_PATH" ]; then
        cmd_args+=(-e "$COMPOSE_SPEC_ENV_FILE_PATH")
    fi
    for profile in "${COMPOSE_SPEC_PROFILES[@]}"; do
        cmd_args+=(-g "$profile")
    done
    cmd_args+=(-s "$COMPOSE_SPEC_STACK_PATH")

    local wait_resolution
    local wait_enabled="false"
    local wait_timeout_value="${WAIT_FOR_HEALTHY_TIMEOUT_DEFAULT:-300}"
    wait_resolution=$(resolve_stack_wait_settings "$dir")
    wait_enabled="${wait_resolution%%$'\t'*}"
    wait_timeout_value="${wait_resolution#*$'\t'}"

    if [ "$wait_enabled" = "true" ]; then
        cmd_args+=(--wait --wait-timeout "$wait_timeout_value")
    fi

    if [ "$AUTOSTART_FORCE_RECREATE" = "true" ]; then
        cmd_args+=(--recreate)
    fi

    if [ "$DEBUG_TO_LOG" = "true" ]; then
        cmd_args+=(--debug)
    fi

    # Execute with timeout, capture output for logging
    local output
    local exit_code
    output=$(timeout "$STARTUP_TIMEOUT" "${cmd_args[@]}" 2>&1)
    exit_code=$?
    
    local duration=$(($(date +%s) - start_time))
    
    if [ $exit_code -eq 0 ]; then
        log "Stack $stack_name started successfully in ${duration}s"
        return 0
    elif [ $exit_code -eq 124 ]; then
        log "ERROR: Stack $stack_name startup timed out after ${STARTUP_TIMEOUT}s"
        return 124
    else
        log "ERROR: Stack $stack_name failed to start (exit code: $exit_code)"
        # Log last few lines of output for debugging
        echo "$output" | tail -5 | while read line; do
            [ -n "$line" ] && log "  $stack_name: $line"
        done
        return $exit_code
    fi
}

# Main execution
log "=== Compose Manager Autostart Begin ==="

if [ -z "$COMPOSE_ROOT" ] || [ ! -d "$COMPOSE_ROOT" ]; then
    log "ERROR: Invalid compose root path: '$COMPOSE_ROOT'"
    exit 1
fi

# Always wait for Docker daemon readiness to avoid early-boot startup races.
if ! wait_for_docker_daemon; then
    log "=== Compose Manager Autostart Aborted (docker unavailable) ==="
    exit 1
fi

# Optionally wait for Docker autostart containers to complete
if [ "$WAIT_FOR_DOCKER" = "true" ]; then
    wait_for_docker_autostart
fi

# Collect stacks with autostart enabled, sorted by saved UI order.
declare -a stacks_to_start
declare -A stack_order_positions

while IFS=$'\t' read -r project_name position; do
    if [ -n "$project_name" ] && [ -n "$position" ]; then
        stack_order_positions["$project_name"]=$position
    fi
done < <(load_saved_stack_order "$COMPOSE_ROOT")

for dir in "$COMPOSE_ROOT"/*; do
    if [ -d "$dir" ]; then
        if has_compose_file "$dir" || [ -f "$dir/indirect" ]; then
            if [ -f "$dir/autostart" ] && [ "true" == "$(< "$dir/autostart")" ]; then
                # Get stack name
                local_name=""
                if [ -f "$dir/name" ]; then
                    local_name=$(< "$dir/name")
                else
                    local_name=$(basename "$dir")
                fi
                
                stacks_to_start+=("$dir|$local_name")
            fi
        fi
    fi
done

# Sort stacks by saved UI order.
IFS=$'\n' sorted_stacks=($(for stack in "${stacks_to_start[@]}"; do
    dir="${stack%%|*}"
    project="$(basename "$dir")"
    order_position="${stack_order_positions[$project]:-999999}"
    printf '%s\t%s\n' "$order_position" "$stack"
done | sort -t$'\t' -k1,1n -k2,2f | cut -f2-))
unset IFS

total_stacks=${#sorted_stacks[@]}
log "Found $total_stacks stacks with autostart enabled"

if [ $total_stacks -eq 0 ]; then
    log "=== Compose Manager Autostart Complete (no stacks) ==="
    exit 0
fi

# Start stacks sequentially (one at a time for reliability)
succeeded=0
failed=0
timedout=0
current=0

for stack_entry in "${sorted_stacks[@]}"; do
    dir="${stack_entry%%|*}"
    stack_name="${stack_entry#*|}"
    current=$((current + 1))
    
    log "[$current/$total_stacks] Processing: $stack_name"
    
    # Start stack and wait for it to complete before moving to next
    start_stack "$dir" "$stack_name"
    exit_code=$?
    
    case $exit_code in
        0) succeeded=$((succeeded + 1)) ;;
        124) timedout=$((timedout + 1)) ;;
        *) failed=$((failed + 1)) ;;
    esac
done

log "=== Compose Manager Autostart Complete ==="
log "Results: $succeeded succeeded, $failed failed, $timedout timed out (of $total_stacks total)"

# Exit with error if any failed (for logging purposes, doesn't affect Unraid)
if [ $failed -gt 0 ] || [ $timedout -gt 0 ]; then
    exit 1
fi
exit 0